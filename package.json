{
  "name": "arcmandate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.8.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:contracts": "node scripts/forge.mjs build --root contracts",
    "test:contracts": "node scripts/forge.mjs test --root contracts",
    "artifacts": "npm run build:contracts && node scripts/export-artifacts.mjs",
    "test:ts": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p services/automation/tsconfig.json && npm run typecheck -w @arcmandate/web",
    "automation:dev": "wrangler dev --config services/automation/wrangler.jsonc --env testnet",
    "automation:build": "wrangler deploy --config services/automation/wrangler.jsonc --dry-run",
    "automation:deploy": "wrangler deploy --config services/automation/wrangler.jsonc",
    "build:web": "npm run artifacts && npm run build -w @arcmandate/web",
    "dev": "npm run dev -w @arcmandate/web",
    "preview": "npm run preview -w @arcmandate/web",
    "smoke:web": "node scripts/web-smoke-server.mjs",
    "check": "npm run check:syntax && npm run typecheck && npm run test:ts && npm run build:web && npm run build:contracts && npm run test:contracts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preflight": "tsx scripts/preflight.ts && tsx scripts/pq-probe.ts",
    "pq:probe": "tsx scripts/pq-probe.ts",
    "fixtures:generate": "tsx scripts/generate-digest-fixtures.ts",
    "accounts:testnet": "tsx scripts/create-testnet-accounts.ts",
    "agent:pay": "tsx scripts/agent-pay.ts",
    "agent:create": "tsx scripts/agent-create.ts",
    "release:snapshot": "tsx scripts/release-snapshot.ts",
    "demo:testnet": "tsx scripts/testnet-demo.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261010.1",
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.57.0"
  }
}
