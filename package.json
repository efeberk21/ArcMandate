{
  "name": "arcmandate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/core"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:contracts": "node scripts/forge.mjs build --root contracts",
    "test:contracts": "node scripts/forge.mjs test --root contracts",
    "artifacts": "npm run build:contracts && node scripts/export-artifacts.mjs",
    "test:ts": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && npm run typecheck -w @arcmandate/web",
    "build:web": "npm run artifacts && npm run build -w @arcmandate/web",
    "dev": "npm run dev -w @arcmandate/web",
    "smoke:web": "node scripts/web-smoke-server.mjs",
    "check": "npm run typecheck && npm run test:ts && npm run build:web && npm run build:contracts && npm run test:contracts",
    "preflight": "tsx scripts/preflight.ts && tsx scripts/pq-probe.ts",
    "pq:probe": "tsx scripts/pq-probe.ts",
    "fixtures:generate": "tsx scripts/generate-digest-fixtures.ts",
    "accounts:testnet": "tsx scripts/create-testnet-accounts.ts",
    "demo:testnet": "tsx scripts/testnet-demo.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@openzeppelin/contracts": "5.6.1",
    "viem": "2.57.0"
  }
}
